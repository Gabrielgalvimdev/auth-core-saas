# Variaveis de ambiente do Auth Core para SaaS
# Copie este arquivo para .env e preencha com seus valores

# --- Server ---
PORT=8080
GRPC_PORT=9090
ENV=development

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/auth_core?sslmode=disable

# --- JWT ---
JWT_SECRET=sua-chave-secreta-mude-em-producao
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- Redis (Token Store) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=info

# --- Producao ---
ALLOWED_ORIGINS=http://localhost:3000
CORS_ENABLED=true
